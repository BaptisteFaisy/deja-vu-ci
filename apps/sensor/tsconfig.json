{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "jsx": "react-jsx",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@dejavu/core": [
        "../../packages/core/src/index.ts",
        "../../packages/core/src/types.ts"
      ],
      "@dejavu/bridge": ["../../packages/bridge/src/index.ts"],
      "@dejavu/present": ["../../packages/present/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
